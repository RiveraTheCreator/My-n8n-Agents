      "credentials": {
        "openAiApi": {
          "id": "EXOwwjSfNqx4ndc7",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "command": "=ffmpeg -i {{ $json.originalClipFile }} -vf \"crop=in_h*9/16:in_h:(in_w-in_h*9/16)/2:0\" -c:a copy {{ $json.clip9x16File }}"
      },
      "id": "8b2fa192-cd52-4e8a-b2d1-d562e8377575",
