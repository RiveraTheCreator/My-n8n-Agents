        },
        "messages": {
          "values": [
            {
              "content": "=Given these timestamps, generate an ffmpeg command to pull those specific clips out of a given video. The goal is the create individual short clips from a long video.\n\nReturn the executable command in a json object like this:\n{ \"command\": <\"ffmpeg command here\"> }\n\nPlease use the input file name for the command:\n/files/{{ $('Get File Name').item.json.folderName }}.mp4\n\nPlease make sure the resulting clips are named \"clip1.mp4, clip2.mp4, ...\" and put them in the following folder:\n/files/{{ $('Get File Name').item.json.folderName }}/clips/\n\nHere are the timestamps in a json object to use for the command:\n{{ $json.message.content.clip1 }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
      "id": "b995d87b-694f-4729-9f5c-f31234f4e608",
