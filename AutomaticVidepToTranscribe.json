        "messages": {
          "values": [
            {
              "content": "=You are an expert marketer helping to build short clips from a full video. In this case we are trying identify the steps from this tutorial to create a short video out of a long tutorial. Provided is the transcript of the video with timestamps. Return the timestamps that are relevant for a complete step by step tutorial in short form, only the specific steps, no filler or explanation needed. Provide all clip timestamps outputted in JSON format like so:\n{ \"clip1\": \"<timestamps>\", \"clip2\": \"<timestamp>\",...}\n\nHere is the transcript:\n {{ $json.stdout }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
