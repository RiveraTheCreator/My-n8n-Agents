        "messages": {
          "values": [
            {
              "content": "=Given a list of video files, generate an ffmpeg command that will combine them all sequentially in order into 1 clip. Do not concat, use the -filter-complex command. \n\nThe input files will be in this directory:  {{ $('Video Values').last().json.videoFolder }}/mobile-clips\n\nReference the input files like this:\n {{ $('Video Values').last().json.videoFolder }}/mobile-clips/mobile-clip1.mp4\n\nOutput the resulting video with this file name: \n {{ $('Video Values').last().json.videoFolder }}/mobile-full.mp4\n\nReturn the response in a JSON format like this:\n{ \"command\": \"<ffmpeg command here>\" }\n\nHere is the list of video files:\n{{ $json.fileName }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
